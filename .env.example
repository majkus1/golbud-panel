NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Publiczny adres panelu (linki w mailach: reset hasła, digest crona). Na Vercel PRODUKCJA — stała domena, nie preview.
# Np. https://twoja-apka.vercel.app lub https://panel.golbud.pl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron: dzienny digest przypomnień (tylko serwer — nie NEXT_PUBLIC_*)
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP — wysyłka faktur i innych maili z panelu (Vercel → Environment Variables, tylko Production)
# Konto Gmail musi mieć 2FA. Hasło = „Hasło aplikacji” z https://myaccount.google.com/apppasswords (16 znaków, spacje opcjonalne).
SMTP_GMAIL_USER=twoj@gmail.com
SMTP_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Opcjonalnie inny „From” (domyślnie = SMTP_GMAIL_USER)
# SMTP_GMAIL_FROM=

# Fallback: gdy nikt nie ma włączonego digestu w Ustawienia → Zespół (przecinek / średnik)
REMINDER_DIGEST_TO=

# Web Push (PWA) — wygeneruj: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcjonalnie kontakt VAPID (domyślnie SMTP_GMAIL_USER)
# VAPID_SUBJECT=mailto:powiadomienia@twoja-domena.pl

# PDF oferty — domyślnie w lib/golbud-offer-config.ts (edycja w kodzie).
# Poniższe tylko jeśli chcesz nadpisać bez deployu kodu:
# OFFER_BANK_ACCOUNT=
# OFFER_DEFAULT_VAT_RATE=8

# OpenAI — asystent AI (RAG) i OCR faktur kosztowych (tylko serwer)
OPENAI_API_KEY=
# Domyślnie gpt-5.4-mini; opcjonalnie inny model Responses API
OPENAI_MODEL=gpt-5.4-mini
# OCR faktur (import rentowności) i załączników asystenta AI — opcjonalnie osobny model
# OPENAI_OCR_MODEL=gpt-5.4-mini
